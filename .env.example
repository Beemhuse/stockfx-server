# ---- Core ----
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/stockfxdb

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,https://www.stockfxinvestment.org

# ---- Auth ----
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
EMAIL_FROM=StockFX <no-reply@yourdomain.com>

# ---- One-time passcodes ----
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# ---- Administrator (single account, enforced on boot) ----
ADMIN_EMAIL=admin@yourdomain.com
# REQUIRED in production - the server refuses to boot without it.
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
